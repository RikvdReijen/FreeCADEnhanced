        <property name="prefEntry" stdset="0"><cstring>LinkToken</cstring></property>
        <property name="prefPath" stdset="0"><cstring>Mod/GameBridge</cstring></property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="Gui::PrefCheckBox" name="linkAutoPublish">
        <property name="text"><string>Publish automatically as the document changes</string></property>
        <property name="checked"><bool>true</bool></property>
        <property name="prefEntry" stdset="0"><cstring>LinkAutoPublish</cstring></property>
        <property name="prefPath" stdset="0"><cstring>Mod/GameBridge</cstring></property>
