  <layout class="QVBoxLayout" name="outerLayout">
   <item>
    <widget class="QGroupBox" name="exportGroup">
     <property name="title"><string>Export</string></property>
     <layout class="QGridLayout" name="exportLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="targetLabel">
        <property name="text"><string>Default engine</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="Gui::PrefComboBox" name="target">
        <property name="toolTip">
         <string>Which engine the export commands and the export dialog use by default.</string>
        </property>
        <property name="currentIndex"><number>0</number></property>
        <property name="prefEntry" stdset="0"><cstring>Target</cstring></property>
        <property name="prefPath" stdset="0"><cstring>Mod/GameBridge</cstring></property>
        <item><property name="text"><string notr="true">unreal</string></property></item>
        <item><property name="text"><string notr="true">unity</string></property></item>
        <item><property name="text"><string notr="true">blender</string></property></item>
