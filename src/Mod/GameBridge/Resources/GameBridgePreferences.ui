        </property>
        <property name="minimum"><number>1024</number></property>
        <property name="maximum"><number>65535</number></property>
        <property name="value"><number>54321</number></property>
        <property name="prefEntry" stdset="0"><cstring>LinkPort</cstring></property>
        <property name="prefPath" stdset="0"><cstring>Mod/GameBridge</cstring></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="linkTargetLabel">
        <property name="text"><string>Send in the space of</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="Gui::PrefComboBox" name="linkTarget">
        <property name="toolTip">
         <string>Which engine's coordinate system and units the link converts to.</string>
        </property>
        <property name="prefEntry" stdset="0"><cstring>LinkTarget</cstring></property>
        <property name="prefPath" stdset="0"><cstring>Mod/GameBridge</cstring></property>
        <item><property name="text"><string notr="true">unity</string></property></item>
        <item><property name="text"><string notr="true">unreal</string></property></item>
        <item><property name="text"><string notr="true">blender</string></property></item>
